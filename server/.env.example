# ── PostpartumHeal Backend — Environment Variables ──────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<replace-with-64-byte-hex-secret>
JWT_REFRESH_SECRET=<replace-with-64-byte-hex-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLIENT_URL=http://localhost:4200
RAG_API_URL=http://127.0.0.1:8000/ask
